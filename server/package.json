{
  "name": "server",
  "version": "0.2.0",
  "private": true,
  "description": "The backend: Express 5 API, socket.io live class, SQLite storage, MCP server for AI assistants",
  "homepage": "https://github.com/Shestac92/cuadrilo#readme",
  "bugs": {
    "url": "https://github.com/Shestac92/cuadrilo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shestac92/cuadrilo.git",
    "directory": "server"
  },
  "author": "Aleksandr Shestakov",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "create-teacher": "tsx --env-file-if-exists=../.env src/scripts/create-teacher.ts",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "test:unit": "tsx --test \"test/unit/*.test.ts\"",
    "test:api": "tsx --test \"test/api/*.test.ts\""
  },
  "dependencies": {
    "@cuadrilo/shared": "0.2.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "sharp": "0.35.5",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "socket.io-client": "4.8.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
