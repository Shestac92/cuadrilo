# Settings of this installation. Copy to .env (git-ignored) and edit:
#   cp .env.example .env
# Every line is optional; a value set in the shell wins over this file.
# The server reads it when it starts and the client when it is built: restart after a change.
# A value with spaces goes in double quotes.

# Port of the backend (the client's dev server and `npm run share` proxy to it).
PORT=8080

# Interface language of the whole installation: es or en. Chosen when the
# client is built: after a change restart `npm run dev` / `npm run share`.
APP_LANG=es

# The address AI assistants (Claude, ChatGPT) reach this server at, with no
# trailing slash: OAuth and the MCP address are built from it. Needed for
# `npm run share`; without it it is http://localhost:<PORT>.
PUBLIC_URL=http://localhost:5173

# Hostnames `npm run share` answers to (comma-separated): the tunnel's domain.
SHARE_HOSTS=your-name.ngrok-free.app

# The students' own language: the translator translates the lesson's words (APP_LANG) into it. The dictionary
# is dictionaries/<APP_LANG>-<TRANSLATION_LANG>.db. No default: leave it out and there is no translator, the same
# when the file of the pair is missing.
TRANSLATION_LANG=ru

# Where lessons.db and media/ live (default: ./data; a relative path is from the repository root).
DATA_DIR=./data

# The platform's name: the page title, header, login, notices, the AI assistants'
# connection and the privacy policy. Default: Cuadrilo.
PLATFORM_NAME="Aula Verde"

# The icon of the browser tab: the path of a .svg, .png or .ico file (a relative path is from the repository root).
# Read when the client is built. Leave it out for the platform's own icon.
FAVICON=./data/favicon.png

# Values for the privacy policy (docs/privacy.<lang>.md, shown at /privacy), read when the client
# is built. A build warns about the ones left out; the policy then shows {{name}} in their place.
# The values below are examples: replace them all before publishing the policy.
# The controller is the teacher: they decide how the students' data is used and answer for it.
# Who is responsible for the students' data, as it should read in the policy: a person or a school.
CONTROLLER_NAME="Ana García"
# Where students or their parents send requests about their data (access, copy, deletion): an e-mail is best.
CONTROLLER_CONTACT=ana@example.com
# The company that hosts the server and processes the data on the controller's behalf.
HOST_NAME="Hetzner Online GmbH"
# The country where that server stands.
HOSTING_COUNTRY=Germany
# Optional. One sentence on moving the data to other countries, or the safeguard used (for example
# standard contractual clauses). Leave it out if the data stays in HOSTING_COUNTRY.
TRANSFER_NOTE="The data does not leave Germany."
